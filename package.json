{
  "name": "port-sentinel",
  "version": "1.0.0",
  "description": "A CLI that finds open TCP ports on a host or CIDR range and identifies the service from its banner",
  "main": "dist/cli.js",
  "bin": {
    "port-sentinel": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kev-69/port-sentinel.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/kev-69/port-sentinel/issues"
  },
  "homepage": "https://github.com/kev-69/port-sentinel#readme",
  "dependencies": {
    "commander": "^15.0.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "fast-check": "^4.10.2",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
